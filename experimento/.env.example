# Copie para .env e preencha. O .env fica fora do git; este exemplo é
# versionado para documentar o que precisa existir.
#
#   cp experimento/.env.example experimento/.env
#   chmod 600 experimento/.env
#
# O harness lê o .env ao iniciar; uma variável já exportada no shell vale mais
# que o arquivo. O nome tem de casar com `acesso.env` de modelos.yaml.

# openrouter.ai/settings/keys (uma chave para os quatro modelos; L5b)
OPENROUTER_API_KEY=
